{
  "name": "mailed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch --env-file-if-exists=.env src/worker/index.ts\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev.ts",
    "mail:test-inbound": "tsx --env-file-if-exists=.env scripts/send-test-inbound.ts",
    "mail:rerender": "tsx --env-file-if-exists=.env scripts/rerender-html.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "geist": "^1.7.2",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "imapflow": "^2.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "mailauth": "^7.2.0",
    "mailparser": "^3.9.38",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.18.0",
    "smtp-server": "^3.19.21",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.18",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
