# -----------------------------------------------------------------------------
# Mailed configuration. Copy to `.env` and adjust. Never commit real secrets.
# -----------------------------------------------------------------------------

# Public URL of the web app (used in links inside emails and for CSRF origin checks).
APP_URL=http://localhost:3000
# Random secret (>= 32 chars) used to sign temporary file URLs and webhook tokens.
# Generate with: openssl rand -base64 48
APP_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
DATABASE_URL=postgres://mailed:mailed@localhost:5432/mailed
LOG_LEVEL=info
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
REGISTRATION_ENABLED=true

# -----------------------------------------------------------------------------
# Mail domains
# -----------------------------------------------------------------------------
# Domains this installation hosts mailboxes for. The first one is used for new
# accounts (alice@<first-domain>). Each needs MX/SPF/DKIM/DMARC records — see
# docs/EMAIL_PROVIDER.md.
MAIL_DOMAINS=mailed.local
# Sender used for verification / password-reset emails.
SYSTEM_MAIL_FROM="Mailed <no-reply@mailed.local>"

# -----------------------------------------------------------------------------
# Outbound mail (sending)
# -----------------------------------------------------------------------------
# "none": no external delivery. Mail between local mailboxes still works when
#         LOCAL_DELIVERY=true; mail to external domains fails with a clear error.
# "smtp": authenticated SMTP relay (Postmark, Amazon SES, Mailgun, SendGrid,
#         Resend, Brevo, your own Postfix, ...).
MAIL_OUTBOUND_DRIVER=none
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
# Optional DKIM signing by Mailed itself (only if your relay does not sign).
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=
# Deliver mail addressed to local mailboxes directly instead of via the relay.
LOCAL_DELIVERY=true

# -----------------------------------------------------------------------------
# Inbound mail (receiving) — enable one or more
# -----------------------------------------------------------------------------
# 1) Built-in SMTP receiver (point your MX record at this host; run the worker).
INBOUND_SMTP_ENABLED=false
INBOUND_SMTP_HOST=0.0.0.0
INBOUND_SMTP_PORT=2525
INBOUND_SMTP_TLS_KEY_PATH=
INBOUND_SMTP_TLS_CERT_PATH=
# Run SPF/DKIM/DMARC checks on mail received by the built-in SMTP receiver.
INBOUND_SMTP_VERIFY_SENDER=true

# 2) IMAP polling of a catch-all mailbox hosted by a provider.
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=60
# Optional: move processed messages to this mailbox on the provider side.
IMAP_PROCESSED_MAILBOX=

# 3) Provider webhooks (raw MIME). POST /api/inbound/raw (HMAC) or /api/inbound/mailgun
INBOUND_WEBHOOK_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Attachment storage
# -----------------------------------------------------------------------------
# "local" stores files on disk (single server / development).
# "s3" works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, Wasabi, ...
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Limits & retention
# -----------------------------------------------------------------------------
MAX_MESSAGE_SIZE_MB=25
DEFAULT_QUOTA_MB=5120
SEND_LIMIT_PER_HOUR=100
SEND_LIMIT_PER_DAY=500
TRASH_RETENTION_DAYS=30
SPAM_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Optional services
# -----------------------------------------------------------------------------
# Redis for distributed rate limiting (falls back to PostgreSQL when empty).
REDIS_URL=
# Rspamd HTTP endpoint (e.g. http://localhost:11334) for an extra spam verdict.
RSPAMD_URL=
RSPAMD_PASSWORD=
# DNS-based domain blocklists for links in messages. Check the list's usage
# policy: Spamhaus does not answer queries sent through public resolvers.
DNSBL_ENABLED=false
DNSBL_DOMAIN_ZONES=dbl.spamhaus.org
